<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#102A43"
                android:textSize="28sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Emergency Profile"
                android:textColor="#102A43"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- Information Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="#E3F2FD"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="ⓘ"
                    android:textColor="#1976D2"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Add important emergency information that can help others assist you during an emergency."
                    android:textColor="#245B80"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Basic Emergency Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Information"
            android:textColor="#102A43"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Blood Group -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/bloodGroupLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Blood Group"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBloodGroup"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="textCapCharacters"
                android:hint="e.g. O+, A+, B-, AB+"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Allergies -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/allergiesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:hint="Allergies"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAllergies"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:hint="Enter allergies or type None"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency Contact -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Contact"
            android:textColor="#102A43"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contactNameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="Contact Name"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmergencyContactName"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="textPersonName"
                android:hint="e.g. Parent / Guardian"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/contactPhoneLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Contact Phone"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmergencyContactPhone"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="phone"
                android:hint="Enter phone number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency View -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency QR Visibility"
            android:textColor="#102A43"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose which information can be displayed in your limited emergency view."
            android:textColor="#627D98"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <!-- Blood Group Visibility -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbBloodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show blood group"
            android:textColor="#243B53"
            android:checked="true" />

        <!-- Allergies Visibility -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show allergies"
            android:textColor="#243B53"
            android:checked="true" />

        <!-- Contact Visibility -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbEmergencyContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show emergency contact"
            android:textColor="#243B53"
            android:checked="true"
            android:layout_marginBottom="25dp" />

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Save Emergency Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1976D2"
            app:cornerRadius="16dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>